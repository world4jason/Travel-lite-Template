{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/world4jason/Travel-lite-Template/blob/main/style-generator/style.schema.json",
  "title": "Travel Lite Style Brief v1",
  "description": "Intermediate art direction extracted from a natural-language style prompt. Not executable website configuration and not a finished Style Pack.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "sourceTask",
    "visual",
    "constraints",
    "webTranslation",
    "audit",
    "stage"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,48}$"
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 2
        },
        "en": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "sourceTask": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mood",
        "era",
        "palette",
        "geometry",
        "material",
        "typography",
        "composition"
      ],
      "properties": {
        "mood": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "era": {
          "type": [
            "string",
            "null"
          ]
        },
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "maxColors",
            "swatches",
            "usage"
          ],
          "properties": {
            "mode": {
              "enum": [
                "fixed",
                "source-derived",
                "adaptive",
                "monochrome-plus-accent",
                "monochrome",
                "duotone",
                "multi-hue",
                "gradient",
                "other"
              ]
            },
            "maxColors": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 12
            },
            "swatches": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/swatch"
              }
            },
            "usage": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "family",
            "motifs",
            "outline",
            "edgeQuality"
          ],
          "properties": {
            "family": {
              "type": "string",
              "minLength": 3,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "motifs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "outline": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "weight",
                "character",
                "color"
              ],
              "properties": {
                "weight": {
                  "enum": [
                    "none",
                    "thin",
                    "medium",
                    "bold",
                    "variable"
                  ]
                },
                "character": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "color": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "edgeQuality": {
              "type": "string",
              "minLength": 3,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        },
        "material": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "technique",
            "texture",
            "depth",
            "shadow"
          ],
          "properties": {
            "technique": {
              "type": "string",
              "minLength": 3,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "texture": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "depth": {
              "type": "string",
              "minLength": 3,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "shadow": {
              "enum": [
                "none",
                "contact-soft",
                "graphic"
              ]
            }
          }
        },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "display",
            "utility",
            "hierarchy"
          ],
          "properties": {
            "display": {
              "type": [
                "string",
                "null"
              ]
            },
            "utility": {
              "type": [
                "string",
                "null"
              ]
            },
            "hierarchy": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "composition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "focus",
            "whitespace",
            "layers",
            "notes"
          ],
          "properties": {
            "focus": {
              "type": "string"
            },
            "whitespace": {
              "enum": [
                "generous",
                "balanced",
                "tight"
              ]
            },
            "layers": {
              "type": "string",
              "minLength": 3,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "frameAndOrnament": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "frameLayers",
            "cornerMotifs",
            "dividerMotifs",
            "labelFrames",
            "placements",
            "responsive",
            "evidence"
          ],
          "properties": {
            "role": {
              "enum": [
                "unknown",
                "none",
                "structural",
                "decorative",
                "structural-and-decorative"
              ]
            },
            "frameLayers": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "level",
                  "lineStyle",
                  "weight",
                  "cornerShape",
                  "colorRole",
                  "inset",
                  "notes"
                ],
                "properties": {
                  "level": {
                    "enum": [
                      "outer",
                      "inner",
                      "section",
                      "utility"
                    ]
                  },
                  "lineStyle": {
                    "enum": [
                      "none",
                      "single",
                      "double",
                      "dotted",
                      "dashed",
                      "irregular",
                      "paper-edge",
                      "printed"
                    ]
                  },
                  "weight": {
                    "enum": [
                      "none",
                      "hairline",
                      "thin",
                      "medium",
                      "bold",
                      "variable"
                    ]
                  },
                  "cornerShape": {
                    "enum": [
                      "none",
                      "square",
                      "rounded",
                      "clipped",
                      "wobbly",
                      "scrollwork",
                      "botanical",
                      "geometric"
                    ]
                  },
                  "colorRole": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "inset": {
                    "enum": [
                      "none",
                      "small",
                      "medium",
                      "large",
                      "fluid"
                    ]
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            },
            "cornerMotifs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dividerMotifs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "labelFrames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "placements": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "surface",
                  "treatment",
                  "density"
                ],
                "properties": {
                  "surface": {
                    "enum": [
                      "identity",
                      "chapter",
                      "reading",
                      "operational",
                      "print"
                    ]
                  },
                  "treatment": {
                    "type": "string",
                    "minLength": 3
                  },
                  "density": {
                    "enum": [
                      "none",
                      "sparse",
                      "moderate",
                      "ornate"
                    ]
                  }
                }
              }
            },
            "responsive": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mobile",
                "desktop",
                "print"
              ],
              "properties": {
                "mobile": {
                  "type": "string"
                },
                "desktop": {
                  "type": "string"
                },
                "print": {
                  "type": "string"
                }
              }
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must",
        "avoid",
        "conditional"
      ],
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conditional": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "when",
              "rule"
            ],
            "properties": {
              "when": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "webTranslation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendedBase",
        "implementationTier",
        "transferable",
        "assetTreatment",
        "excludedOriginalInstructions",
        "componentRisks",
        "motion"
      ],
      "properties": {
        "recommendedBase": {
          "enum": [
            "editorial",
            "storybook",
            "candy",
            "risograph",
            "paper-collage",
            "naive-city",
            "taiwan-poster",
            "field-stamp",
            "quiet-linocut",
            "doodle-memory-grid",
            "crayon-journal",
            "painterly-editorial",
            "geometric-print",
            "quiet-acrylic",
            "new-style-pack"
          ]
        },
        "implementationTier": {
          "enum": [
            "token-variant",
            "asset-and-token-variant",
            "new-style-pack"
          ]
        },
        "transferable": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "assetTreatment": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludedOriginalInstructions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instruction",
              "reason"
            ],
            "properties": {
              "instruction": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "componentRisks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "motion": {
          "enum": [
            "inherit",
            "gentle",
            "none"
          ]
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "photoProvided",
        "basis",
        "unknowns",
        "conflicts",
        "assumptions",
        "confidence"
      ],
      "properties": {
        "photoProvided": {
          "type": "boolean"
        },
        "basis": {
          "enum": [
            "text-only",
            "text-and-image"
          ]
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "issue",
              "handling"
            ],
            "properties": {
              "issue": {
                "type": "string"
              },
              "handling": {
                "type": "string"
              }
            }
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "stage": {
      "const": "brief-only"
    }
  },
  "$defs": {
    "swatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "hex",
        "role",
        "origin"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "hex": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "role": {
          "enum": [
            "background",
            "primary",
            "secondary",
            "accent",
            "ink",
            "outline",
            "highlight",
            "environment"
          ]
        },
        "origin": {
          "enum": [
            "explicit",
            "inferred",
            "default"
          ]
        }
      }
    }
  },
  "if": {
    "properties": {
      "schemaVersion": {
        "const": "1.1.0"
      }
    },
    "required": [
      "schemaVersion"
    ]
  },
  "then": {
    "properties": {
      "visual": {
        "required": [
          "frameAndOrnament"
        ]
      }
    }
  }
}
