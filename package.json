{
  "name": "travel-lite-template",
  "private": true,
  "type": "module",
  "scripts": {
    "test:export": "node --test tests/export-core.test.mjs",
    "test:integrity": "node scripts/check-item-ids.mjs",
    "test:mobile": "playwright test --project=chromium",
    "test:mobile:headed": "playwright test --project=chromium --headed",
    "test:styles": "node --test style-generator/tests/*.test.mjs",
    "validate:styles": "node style-generator/validate-style.mjs style-generator/examples",
    "render:style-prompts": "node style-generator/render-style-prompt.mjs style-generator/examples",
    "test:packs": "node --test tests/pack-manifests.test.mjs tests/four-pack-manifests.test.mjs tests/second-batch-manifests.test.mjs",
    "test:style-parity": "node scripts/verify-style-parity.mjs",
    "test:timeline": "node --test tests/chronological-timeline.test.mjs && node scripts/check-chronological-timeline.mjs trip.json",
    "test:uiux": "node --test tests/uiux-contract.test.mjs tests/overview-contract.test.mjs tests/journey-trust.test.mjs",
    "test:contracts": "npm run lint:uiux && npm run test:uiux && npm run test:timeline && npm run test:journey && npm run test:trip-layout && npm run test:overview && npm run test:places-curation && npm run test:overview-artwork && npm run test:icons",
    "test:trip-widgets": "node --test tests/date-weather-flight.test.mjs",
    "lint:uiux": "node --test tests/uiux-lint.test.mjs && node scripts/lint-uiux.mjs && npm run lint:map-insets && npm run verify:icons",
    "test:uiux:geometry": "playwright test tests/map-workspace-insets.spec.mjs tests/uiux-safe-inset.spec.mjs --project=chromium",
    "test:journey": "node --test tests/journey-groups.test.mjs",
    "test:journey:browser": "playwright test tests/journey-timeline.spec.mjs --project=chromium",
    "lint:map-insets": "node --test tests/map-workspace-insets.test.mjs && node scripts/check-map-workspace-insets.mjs",
    "test:map-insets:browser": "playwright test tests/map-workspace-insets.spec.mjs --project=chromium",
    "test:trip-layout": "node --test tests/trip-layout-contract.test.mjs",
    "test:trip-layout:browser": "playwright test tests/trip-responsive-layout.spec.mjs --project=chromium",
    "test:places-curation": "node --test tests/places-curation.test.mjs",
    "test:places-curation:browser": "playwright test tests/places-curation.spec.mjs --project=chromium",
    "test:overview": "node --test tests/overview-contract.test.mjs",
    "test:overview:browser": "playwright test tests/overview-compact.spec.mjs --project=chromium",
    "test:trust": "node --test tests/journey-trust.test.mjs",
    "test:overview-artwork": "node --test tests/overview-artwork.test.mjs",
    "artwork:prepare": "node tools/artwork/prepare-cover-jobs.mjs",
    "artwork:generate": "node tools/artwork/generate-covers.mjs",
    "artwork:judge": "node tools/artwork/judge-covers.mjs",
    "artwork:verify": "python3 tools/artwork/verify-covers.py",
    "artwork:verify:legacy": "python3 tools/artwork/verify-covers.py --legacy-trip-images --report artwork/quality/legacy-verification-report.json",
    "artwork:publish": "node tools/artwork/publish-approved-covers.mjs",
    "test:artwork-verify": "python3 -m unittest discover -s tests -p test_cover_verifier.py",
    "artwork:verify:browser": "playwright test tests/overview-artwork-visual.spec.mjs --project=chromium",
    "artwork:stage": "node tools/artwork/stage-cover-assets.mjs",
    "verify:icons": "node scripts/verify-icon-catalog.mjs",
    "test:icons": "node --test tests/icon-semantic.test.mjs",
    "test:icons:browser": "playwright test tests/icon-semantic.spec.mjs --project=chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "maplibre-gl": "6.10.0"
  }
}
