{
  "name": "travel-lite-template",
  "private": true,
  "type": "module",
  "scripts": {
    "test:export": "node --test tests/export-core.test.mjs",
    "test:integrity": "node scripts/check-item-ids.mjs",
    "test:mobile": "playwright test --project=chromium",
    "test:mobile:headed": "playwright test --project=chromium --headed",
    "test:styles": "node --test style-generator/tests/*.test.mjs",
    "validate:styles": "node style-generator/validate-style.mjs style-generator/examples",
    "render:style-prompts": "node style-generator/render-style-prompt.mjs style-generator/examples",
    "test:packs": "node --test tests/pack-manifests.test.mjs tests/four-pack-manifests.test.mjs tests/second-batch-manifests.test.mjs",
    "test:style-parity": "node scripts/verify-style-parity.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "maplibre-gl": "6.10.0"
  }
}
